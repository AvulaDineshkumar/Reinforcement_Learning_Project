<mxfile host="app.diagrams.net"><diagram name="Corrected architecture"><mxGraphModel dx="1200" dy="800" grid="1" gridSize="10" page="1" pageWidth="1100" pageHeight="700"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="data" value="&lt;b&gt;ESA-ADB Mission 1&lt;/b&gt;&lt;br&gt;Real telemetry + expert annotations&lt;br&gt;12 target channels, 2000–2013" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dbe9f6;strokeColor=#3b78b0;fontSize=12;" vertex="1" parent="1"><mxGeometry x="18" y="63" width="204" height="75" as="geometry"/></mxCell><mxCell id="prep" value="&lt;b&gt;Preprocessing&lt;/b&gt;&lt;br&gt;90 s common grid&lt;br&gt;Interpolate gaps ≤ 4.5 min only&lt;br&gt;Long gaps left missing" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dbe9f6;strokeColor=#3b78b0;fontSize=12;" vertex="1" parent="1"><mxGeometry x="18" y="165" width="204" height="81" as="geometry"/></mxCell><mxCell id="split" value="&lt;b&gt;Event-level split&lt;/b&gt;&lt;br&gt;168 events → 117 / 25 / 26&lt;br&gt;Label-clean segments&lt;br&gt;→ train / val / test" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dbe9f6;strokeColor=#3b78b0;fontSize=12;" vertex="1" parent="1"><mxGeometry x="18" y="273" width="204" height="81" as="geometry"/></mxCell><mxCell id="ae" value="&lt;b&gt;LSTM autoencoder&lt;/b&gt;&lt;br&gt;128-sample (3.2 h) windows&lt;br&gt;Trained on label-clean&lt;br&gt;train-split windows" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e3f1df;strokeColor=#3f8f3f;fontSize=12;" vertex="1" parent="1"><mxGeometry x="258" y="63" width="204" height="81" as="geometry"/></mxCell><mxCell id="score" value="&lt;b&gt;Anomaly scoring&lt;/b&gt;&lt;br&gt;Overall + 12 channel-wise&lt;br&gt;reconstruction errors&lt;br&gt;(z-score, ±10σ clip)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e3f1df;strokeColor=#3f8f3f;fontSize=12;" vertex="1" parent="1"><mxGeometry x="258" y="165" width="204" height="81" as="geometry"/></mxCell><mxCell id="det" value="&lt;b&gt;Detection&lt;/b&gt;&lt;br&gt;Window error ≥ threshold&lt;br&gt;(threshold fixed on validation,&lt;br&gt;frozen for test)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e3f1df;strokeColor=#3f8f3f;fontSize=12;" vertex="1" parent="1"><mxGeometry x="258" y="273" width="204" height="81" as="geometry"/></mxCell><mxCell id="case" value="&lt;b&gt;Investigation case&lt;/b&gt;&lt;br&gt;Highest-error detected window&lt;br&gt;of a confirmed event" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fdebd3;strokeColor=#c77a12;fontSize=12;" vertex="1" parent="1"><mxGeometry x="258" y="381" width="204" height="81" as="geometry"/></mxCell><mxCell id="state" value="&lt;b&gt;DQN state (25)&lt;/b&gt;&lt;br&gt;log1p(12 channel errors)&lt;br&gt;12 status values + budget left" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fdebd3;strokeColor=#c77a12;fontSize=12;" vertex="1" parent="1"><mxGeometry x="498" y="63" width="216" height="75" as="geometry"/></mxCell><mxCell id="agent" value="&lt;b&gt;DQN agent&lt;/b&gt;&lt;br&gt;Q-network 25→64→64→12&lt;br&gt;Replay buffer, target network&lt;br&gt;ε-greedy, invalid actions masked" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fdebd3;strokeColor=#c77a12;fontSize=12;" vertex="1" parent="1"><mxGeometry x="498" y="165" width="216" height="81" as="geometry"/></mxCell><mxCell id="action" value="&lt;b&gt;Action&lt;/b&gt;&lt;br&gt;Investigate 1 of 12 channels&lt;br&gt;Budget −1 per action&lt;br&gt;Episode ends after 5" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fdebd3;strokeColor=#c77a12;fontSize=12;" vertex="1" parent="1"><mxGeometry x="498" y="273" width="216" height="81" as="geometry"/></mxCell><mxCell id="reward" value="&lt;b&gt;Reward&lt;/b&gt;&lt;br&gt;+1 annotated channel&lt;br&gt;−1 not annotated" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fdebd3;strokeColor=#c77a12;fontSize=12;" vertex="1" parent="1"><mxGeometry x="498" y="381" width="216" height="81" as="geometry"/></mxCell><mxCell id="labels" value="&lt;b&gt;Ground-truth annotations&lt;/b&gt;&lt;br&gt;Used only for reward,&lt;br&gt;case association &amp; evaluation&lt;br&gt;(never in the initial state)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fbe0e0;strokeColor=#b33a3a;fontSize=12;" vertex="1" parent="1"><mxGeometry x="750" y="381" width="204" height="81" as="geometry"/></mxCell><mxCell id="base" value="&lt;b&gt;Baselines&lt;/b&gt;&lt;br&gt;Random (×1000), Fixed priority,&lt;br&gt;LSTM-greedy, Oracle bound" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ece3f3;strokeColor=#7653a1;fontSize=12;" vertex="1" parent="1"><mxGeometry x="750" y="63" width="204" height="75" as="geometry"/></mxCell><mxCell id="eval" value="&lt;b&gt;Evaluation (test events)&lt;/b&gt;&lt;br&gt;DQN greedy policy, 5 seeds&lt;br&gt;(best validation checkpoint)&lt;br&gt;mean ± std, Wilcoxon tests" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ece3f3;strokeColor=#7653a1;fontSize=12;" vertex="1" parent="1"><mxGeometry x="750" y="165" width="204" height="81" as="geometry"/></mxCell><mxCell id="metrics" value="&lt;b&gt;Metrics&lt;/b&gt;&lt;br&gt;Avg. reward • Hits • Precision@5&lt;br&gt;Recall@5 • Unnecessary investigations" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ece3f3;strokeColor=#7653a1;fontSize=12;" vertex="1" parent="1"><mxGeometry x="750" y="273" width="204" height="81" as="geometry"/></mxCell><mxCell id="e0" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;fontSize=10;" edge="1" parent="1" source="data" target="prep"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e1" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;fontSize=10;" edge="1" parent="1" source="prep" target="split"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e2" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;fontSize=10;" edge="1" parent="1" source="split" target="ae"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e3" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;fontSize=10;" edge="1" parent="1" source="ae" target="score"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e4" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;fontSize=10;" edge="1" parent="1" source="score" target="det"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e5" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;fontSize=10;" edge="1" parent="1" source="det" target="case"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e6" value="channel errors" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;fontSize=10;" edge="1" parent="1" source="case" target="state"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e7" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;fontSize=10;" edge="1" parent="1" source="state" target="agent"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e8" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;fontSize=10;" edge="1" parent="1" source="agent" target="action"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e9" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;fontSize=10;" edge="1" parent="1" source="action" target="reward"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e10" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;fontSize=10;" edge="1" parent="1" source="labels" target="reward"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e11" value="(s, a, r, s′) + status update" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;fontSize=10;" edge="1" parent="1" source="reward" target="agent"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e12" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;fontSize=10;" edge="1" parent="1" source="agent" target="eval"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e13" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;fontSize=10;" edge="1" parent="1" source="base" target="eval"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e14" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;fontSize=10;" edge="1" parent="1" source="eval" target="metrics"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e15" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;fontSize=10;" edge="1" parent="1" source="labels" target="metrics"><mxGeometry relative="1" as="geometry"/></mxCell></root></mxGraphModel></diagram></mxfile>